{
  "name": "pennspots",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "NODE_USE_ENV_PROXY=1 tsx watch --clear-screen=false src/server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production node --use-env-proxy --import tsx src/server/index.ts",
    "test": "node --import tsx --test src/server/*.test.ts",
    "test:browser": "playwright test",
    "check": "npm test && npm run build && npm run test:browser",
    "format": "prettier --write src tests *.ts *.json *.html README.md"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13",
    "luxon": "^3.7.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
